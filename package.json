{
  "name": "sc-mcp",
  "version": "0.1.0",
  "description": "SafetyCulture MCP proxy — bridges a local stdio MCP client to the SafetyCulture MCP endpoint using an API token.",
  "type": "module",
  "bin": {
    "sc-mcp": "dist/sc-mcp.mjs"
  },
  "files": [
    "dist/sc-mcp.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/sc-mcp.mjs",
    "build": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "start": "node dist/sc-mcp.mjs",
    "prepare": "npm run bundle"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
