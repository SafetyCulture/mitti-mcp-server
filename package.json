{
  "name": "mitti-mcp",
  "version": "0.3.3",
  "description": "Mitti MCP proxy — bridges a local stdio MCP client to the Mitti MCP endpoint using an API token.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mitti-mcp": "dist/mitti-mcp.mjs"
  },
  "files": [
    "dist/mitti-mcp.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "bundle:release": "node scripts/bundle.mjs",
    "build": "tsc",
    "lint": "oxlint .",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "start": "node dist/mitti-mcp.mjs",
    "prepare": "npm run bundle"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  }
}
